# --- Telegram (required) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Gmail ---
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_QUERY=from:KartuKreditBCA@klikbca.com subject:"Credit Card Transaction Notification"
# Cloud deployment only: paste the full JSON content of credentials.json / token.json here.
# Leave blank for local dev (files are used directly).
GMAIL_CREDENTIALS_JSON=
GMAIL_TOKEN_JSON=

# --- App behaviour ---
POLL_INTERVAL_SECONDS=60
DATABASE_PATH=spendsense.db
TIMEZONE=Asia/Jakarta

# --- Weekly summary schedule (previous week) ---
WEEKLY_SUMMARY_DAY=mon
WEEKLY_SUMMARY_HOUR=8
WEEKLY_SUMMARY_MINUTE=0

# --- Optional LLM categorization (Claude) ---
USE_LLM_CATEGORIZATION=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
